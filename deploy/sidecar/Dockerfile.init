# atropos-init: installs the iptables REDIRECT rules for transparent
# capture and writes the capture marker. Runs as root with NET_ADMIN.
#   docker build -f deploy/sidecar/Dockerfile.init -t atropos-init:dev deploy/sidecar
FROM alpine:3.22
RUN apk add --no-cache iptables
COPY init.sh /init.sh
ENTRYPOINT ["/bin/sh", "/init.sh"]
